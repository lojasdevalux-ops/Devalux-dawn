{{ 'cmx-product-tabs.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cmx-product-tabs.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign tabs_buf = '' -%}
{%- assign panels_buf = '' -%}
{%- assign visible_index = 0 -%}

{%- for block in section.blocks -%}
  {%- liquid
    assign content = ''

    if block.settings.source == 'description'
      assign content = product.description
    else
      assign mf_parts = block.settings.metafield | strip | split: '.'
      if mf_parts.size == 2
        assign mf_ns = mf_parts[0]
        assign mf_key = mf_parts[1]
        assign mf = product.metafields[mf_ns][mf_key]
        if mf != blank
          capture content
            echo mf | metafield_tag
          endcapture
        endif
      endif
    endif

    assign probe = content | strip_html | strip
  -%}

  {%- comment -%}
    Aba sem conteúdo não é renderizada: produto que ainda não teve o
    metafield preenchido não mostra aba vazia.
  {%- endcomment -%}
  {%- if probe != blank -%}
    {%- assign visible_index = visible_index | plus: 1 -%}
    {%- assign is_active = false -%}
    {%- if visible_index == 1 -%}
      {%- assign is_active = true -%}
    {%- endif -%}

    {%- assign tab_id = 'cmx-tab-' | append: section.id | append: '-' | append: block.id -%}
    {%- assign panel_id = 'cmx-panel-' | append: section.id | append: '-' | append: block.id -%}

    {%- capture tab_btn -%}
      <button
        type="button"
        class="cmx-tabs__tab{% if is_active %} is-active{% endif %}"
        role="tab"
        id="{{ tab_id }}"
        aria-controls="{{ panel_id }}"
        aria-selected="{% if is_active %}true{% else %}false{% endif %}"
        tabindex="{% if is_active %}0{% else %}-1{% endif %}"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.icon != 'none' -%}
          {%- render 'cmx-tab-icon', icon: block.settings.icon -%}
        {%- endif -%}
        <span>{{ block.settings.heading | escape }}</span>
      </button>
    {%- endcapture -%}
    {%- assign tabs_buf = tabs_buf | append: tab_btn -%}

    {%- capture panel -%}
      <div
        class="cmx-tabs__panel"
        role="tabpanel"
        id="{{ panel_id }}"
        aria-labelledby="{{ tab_id }}"
        tabindex="0"
        {% unless is_active %}hidden{% endunless %}
      >
        <div class="cmx-tabs__content rte">{{ content }}</div>
      </div>
    {%- endcapture -%}
    {%- assign panels_buf = panels_buf | append: panel -%}
  {%- endif -%}
{%- endfor -%}

{%- if visible_index > 0 -%}
  <div class="page-width section-{{ section.id }}-padding">
    <cmx-product-tabs class="cmx-tabs">
      <div class="cmx-tabs__list" role="tablist" aria-label="{{ section.settings.aria_label | escape }}">
        {{ tabs_buf }}
      </div>
      <div class="cmx-tabs__panels">
        {{ panels_buf }}
      </div>
    </cmx-product-tabs>
  </div>
{%- elsif request.design_mode -%}
  <div class="page-width section-{{ section.id }}-padding">
    <div class="cmx-tabs cmx-tabs--empty">
      Nenhuma aba tem conteúdo neste produto. Preencha a descrição ou os
      metafields configurados nos blocos para as abas aparecerem.
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Abas do produto",
  "tag": "section",
  "class": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Cada bloco vira uma aba. Abas sem conteúdo no produto são escondidas automaticamente."
    },
    {
      "type": "text",
      "id": "aria_label",
      "default": "Informações do produto",
      "label": "Descrição para leitores de tela",
      "info": "Não aparece na tela. Descreve o conjunto de abas para acessibilidade."
    },
    {
      "type": "header",
      "content": "Espaçamento"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaço acima",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaço abaixo",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Aba",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Descrição",
          "label": "Nome da aba"
        },
        {
          "type": "select",
          "id": "icon",
          "options": [
            { "value": "description", "label": "Prancheta (descrição)" },
            { "value": "usage", "label": "Lista (modo de uso)" },
            { "value": "ingredients", "label": "Pilão (ingredientes)" },
            { "value": "drop", "label": "Gota" },
            { "value": "leaf", "label": "Folha" },
            { "value": "truck", "label": "Caminhão (entrega)" },
            { "value": "none", "label": "Sem ícone" }
          ],
          "default": "description",
          "label": "Ícone"
        },
        {
          "type": "select",
          "id": "source",
          "options": [
            { "value": "description", "label": "Descrição do produto" },
            { "value": "metafield", "label": "Metafield" }
          ],
          "default": "description",
          "label": "Conteúdo da aba"
        },
        {
          "type": "text",
          "id": "metafield",
          "default": "custom.modo_de_uso",
          "label": "Metafield",
          "info": "Só usado quando o conteúdo for \"Metafield\". Formato: namespace.chave — ex: custom.modo_de_uso"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Abas do produto",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "heading": "Descrição",
            "icon": "description",
            "source": "description"
          }
        },
        {
          "type": "tab",
          "settings": {
            "heading": "Modo de uso",
            "icon": "usage",
            "source": "metafield",
            "metafield": "custom.modo_de_uso"
          }
        },
        {
          "type": "tab",
          "settings": {
            "heading": "Ingredientes",
            "icon": "ingredients",
            "source": "metafield",
            "metafield": "custom.ingredientes"
          }
        }
      ]
    }
  ]
}
{% endschema %}
